# Postgres
POSTGRES_USER=billy
POSTGRES_PASSWORD=billy
POSTGRES_DB=billy
POSTGRES_PORT=5442
# Used by apps running on the host (nx serve). Containers use the compose-internal host.
DATABASE_URL=postgres://billy:billy@localhost:5442/billy

# Redis (BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage (SeaweedFS locally, S3-compatible)
S3_PORT=9100
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=billy
S3_SECRET_KEY=billybilly
S3_BUCKET=billy-documents

# Service ports published on the host
API_PORT=3000
WEB_PORT=3001

# AI
ANTHROPIC_API_KEY=

# File ingestion
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_BATCH=20
BUSINESS_OWNER_ID=default
BUSINESS_WEEK_START=monday
# ISO code used when a document shows no currency
BUSINESS_CURRENCY=USD

# Extraction (cheapest adequate method first: digital -> OCR -> vision)
EXTRACTION_MODEL=claude-haiku-5-5
VISION_MODEL=claude-sonnet-5-5
OCR_MIN_CONFIDENCE=0.70
RECORD_MIN_CONFIDENCE=0.80
# Monthly processing cost limit in USD; empty = no limit
PROCESSING_COST_LIMIT_USD=

# Embeddings (document search / RAG)
EMBEDDING_PROVIDER=voyage
EMBEDDING_MODEL=voyage-3.5-lite
EMBEDDING_DIMENSIONS=1024
VOYAGE_API_KEY=

# Document chat (home screen)
CHAT_MODEL=claude-sonnet-5-5
CHAT_MAX_MESSAGE_CHARS=2000
CHAT_RATE_LIMIT_PER_MINUTE=20
CHAT_CONTEXT_MESSAGES=12
CHAT_TURN_TIMEOUT_MS=45000
