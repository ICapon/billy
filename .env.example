# Postgres
POSTGRES_USER=billy
POSTGRES_PASSWORD=billy
POSTGRES_DB=billy
POSTGRES_PORT=5442
# Used by apps running on the host (nx serve). Containers use the compose-internal host.
DATABASE_URL=postgres://billy:billy@localhost:5442/billy

# Redis (BullMQ)
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Object storage (SeaweedFS locally, S3-compatible)
S3_PORT=9100
S3_ENDPOINT=http://localhost:9100
S3_ACCESS_KEY=billy
S3_SECRET_KEY=billybilly
S3_BUCKET=billy-documents

# Service ports published on the host
API_PORT=3000
WEB_PORT=3001

# AI
ANTHROPIC_API_KEY=
