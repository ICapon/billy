{
  "name": "@org/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json"
  },
  "nx": {
    "name": "db",
    "tags": [
      "scope:db"
    ],
    "targets": {
      "migrate": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/migrate.cjs",
          "cwd": "packages/db"
        },
        "cache": false
      },
      "migrate-revert": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/migrate.cjs --revert",
          "cwd": "packages/db"
        },
        "cache": false
      },
      "migration-create": {
        "executor": "nx:run-commands",
        "options": {
          "command": "node scripts/create-migration.cjs {args.name}",
          "cwd": "packages/db"
        },
        "cache": false
      }
    }
  },
  "dependencies": {
    "@org/shared": "workspace:^",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.0",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1"
  }
}
